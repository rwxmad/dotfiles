#!/bin/bash

# Listen Hyprland events (socket2)
# triggers `lid-internal recover` on monitor detach - turns on the internal monitor if external one is unavailable.

SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

socat -U - "UNIX-CONNECT:$SOCKET" | while read -r event; do
  case "$event" in
    monitorremoved\>\>*|monitorremovedv2\>\>*)
      lid-internal recover
      ;;
  esac
done
